[Unit]
Description=TextView unified message viewer
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=USER
Group=USER
WorkingDirectory=/home/USER/Documents/textview
Environment=NODE_ENV=production
Environment=TEXTVIEW_HOST=127.0.0.1
Environment=TEXTVIEW_PORT=8787
ExecStart=/home/USER/.nvm/versions/node/v24.18.0/bin/node --max-old-space-size=384 /home/USER/Documents/textview/server.mjs
Restart=always
RestartSec=3
TimeoutStopSec=10
MemoryHigh=512M
MemoryMax=768M
OOMPolicy=stop
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/home/USER/Documents/textview

[Install]
WantedBy=multi-user.target
